<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= title %></h1>
    <div>
        <% for(let i = 0; i < messages.length; i++){ %>
        <p><%= messages[i].text %></p>
        <p><%= messages[i].user %></p>
        <p><%= messages[i].added %></p>
        <br>
        <% } %>
    </div>
    <button><a href="/new">new message</a></button>
</body>
</html>